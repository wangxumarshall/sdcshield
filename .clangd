# clangd project config — zero-config for this repo.
#
# Usage: nothing to configure. clangd on PATH + `meson setup builddir` done
# (the symlink ./compile_commands.json -> builddir/compile_commands.json is
# committed) and every editor with clangd support just works: hover, go-to-def,
# references, diagnostics, completion, background index (.cache/, gitignored).
#
# How it works with no per-user setup:
#  - compile db: meson already generates builddir/compile_commands.json at
#    setup time (356 entries, framework + all test TUs). clangd finds it by
#    walking up from the source file to builddir/ automatically — this file
#    exists mainly to pin the fallback flags and keep the index cache local.
#  - the build was configured with user-local -I flags (boost/zstd/gmp-devel
#    extracted under ~/boost-local on hosts without the -devel rpms); those
#    live inside compile_commands.json, so clangd replays them verbatim.
#  - regenerate after meson reconfigure: the file is refreshed by meson
#    itself, nothing to do manually.
CompileFlags:
  Add: [-D__clangd__]
Diagnostics:
  # IncludeCleaner (the unused-includes feature) chokes on this project's
  # is_system include trees (eigen5/ACL installed headers resolved via
  # absolute -I paths) and spams "Failed to get an entry for resolved path"
  # on every parse; the feature adds little here, so it is off.
  UnusedIncludes: None
  # ACL v23.02 NEFunctions.h pImpl quirk: sizeof on a forward-declared Impl
  # inside the header itself (GCC tolerates, clang diagnoses). Upstream
  # header issue, not project code — suppressed to keep the error list clean.
  Suppress: ["reserved_identifier", "sizeof_alignof_incomplete_or_sizeless_type"]
Index:
  Background: Build

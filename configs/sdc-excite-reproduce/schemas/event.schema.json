{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdcshield.local/schemas/sdc-excite-reproduce/event.schema.json",
  "title": "SDC canonical event",
  "description": "Declarative transcription of the v5 spec §5.3 canonical event schema. Types, enums and `required` mirror tools/telemetry/sdc_event.py::validate_event, with `time` nullable and hex fields accepted per the validator's str() coercion (schema string/pattern is stricter than the validator); this file is documentation, the stdlib validator is the enforcement point.",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "severity",
    "sdc-excite-reproduce_id",
    "run_id",
    "time"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "description": "全局唯一事件 ID（UUIDv7 风格，时间有序）"
    },
    "parent_event_id": {
      "type": ["string", "null"],
      "description": "关联事件（如 interlock_action 指向触发它的 sdc_mismatch）"
    },
    "event_type": {
      "enum": [
        "sdc_mismatch",
        "crash",
        "ras_event",
        "spurious_fault",
        "sel_event",
        "interlock_action",
        "phase_boundary",
        "note"
      ]
    },
    "severity": {
      "enum": ["green", "yellow", "orange", "red", "black"]
    },
    "confidence": {
      "enum": ["observed", "inferred", "hypothetical"]
    },
    "sdc-excite-reproduce_id": {
      "type": "string",
      "description": "所属战役实例（<时间戳>-<机器>-<档位>-<短哈希>）"
    },
    "run_id": {
      "type": "string",
      "description": "单次压测运行 ID；与 test.iteration 一起构成重放键"
    },
    "test": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "family": {"type": "string"},
        "workload_type": {"type": "string"},
        "instruction_width_bits": {"type": "integer"},
        "seed": {
          "type": "string",
          "description": "RNG 引擎与状态（如 AES:ebcafcfb），用于命中后重放"
        },
        "iteration": {"type": "integer"},
        "retry": {"type": "boolean"},
        "knobs": {"type": "object"}
      }
    },
    "result": {
      "type": "object",
      "properties": {
        "verdict": {
          "enum": ["PASS", "FAIL", "SKIP", "CRASH", "TIMED_OUT", "INTERRUPTED", "OSE"]
        },
        "t_start_realtime_ns": {"type": "integer"},
        "t_end_realtime_ns": {"type": "integer"},
        "duration_ns": {"type": "integer"},
        "cpu_cycles": {"type": "integer"},
        "cntvct_delta": {"type": "integer"}
      }
    },
    "location": {
      "type": "object",
      "description": "拓扑五元组（v5 §4.2 拓扑契约）；CPU179 案例的核定位依赖此段",
      "properties": {
        "logical_cpu": {"type": "integer"},
        "core_id": {"type": "integer"},
        "socket_id": {"type": "integer"},
        "die_id": {"type": "integer"},
        "cluster_id": {"type": "integer"},
        "numa_node": {"type": "integer"}
      }
    },
    "time": {
      "type": ["object", "null"],
      "description": "五元时间（v5 §4.2）；禁硬编码频率假设，cntfrq_hz 必须实测。null = legacy 事件缺五元数据（校验器同此宽限）",
      "properties": {
        "realtime_ns": {"type": "integer"},
        "monotonic_raw_ns": {"type": "integer"},
        "uptime_ns": {"type": "integer"},
        "cntvct": {"type": "integer"},
        "cntfrq_hz": {"type": "integer", "exclusiveMinimum": 0},
        "bmc_time_raw": {"type": ["string", "null"]},
        "mapping_error_ns": {"type": "integer"}
      }
    },
    "mismatch": {
      "type": "object",
      "description": "位翻转掩码 = O XOR T 逐字节（v5 §5.3），用于单元归因与跨事件聚类",
      "properties": {
        "type": {"type": "string"},
        "byte_offset": {"type": "integer"},
        "suboffset": {"type": "integer"},
        "lane": {"type": "integer"},
        "actual_hex": {"type": "string", "pattern": "^(0x)?[0-9a-fA-F]+$"},
        "expected_hex": {"type": "string", "pattern": "^(0x)?[0-9a-fA-F]+$"},
        "xor_mask_hex": {"type": "string", "pattern": "^(0x)?[0-9a-fA-F]+$"},
        "popcount": {"type": "integer"}
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "temperature_c": {"type": ["number", "null"]},
        "frequency_khz": {"type": ["integer", "null"]},
        "voltage_v": {"type": ["number", "null"]},
        "package_power_w": {"type": ["number", "null"]},
        "pmu_window_id": {"type": ["string", "null"]}
      }
    },
    "artifacts": {
      "type": "array",
      "description": "提取式取证清单（不复制 GB 级原件）"
    },
    "classification": {
      "type": "object",
      "properties": {
        "primary": {"type": "string"},
        "alternatives": {"type": "array", "items": {"type": "string"}},
        "status": {
          "enum": ["open", "qualified", "invalid", "test_bug", "resolved"]
        }
      }
    }
  }
}

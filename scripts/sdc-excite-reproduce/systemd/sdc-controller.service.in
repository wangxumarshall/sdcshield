[Unit]
Description=SDCShield sdc-excite-reproduce controller (user: five-state rule state machine + decision ledger)
After=sdc-eventd.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
ExecStart=/usr/bin/python3 @REPO@/tools/control/sdc_controller.py --data-root @CAMPAIGN_DIR@
Environment=SDC_EXCITE_REPRODUCE_DIR=@CAMPAIGN_DIR@
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
